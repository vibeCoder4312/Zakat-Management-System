# ==============================================================================
# Zakat & Charity Management System (App 151 Migration)
# Environment Configuration Template
# ==============================================================================

# Database Configuration
POSTGRES_DB=zakat_db
POSTGRES_USER=zakat_user
# REQUIRED: Set a strong database password
POSTGRES_PASSWORD=change-me-to-a-secure-database-password
POSTGRES_PORT=5432
DB_BIND_IP=127.0.0.1

# Backend Spring Boot Configuration
BACKEND_PORT=8080
BACKEND_BIND_IP=127.0.0.1
# REQUIRED: at least 32 random characters (256 bits). Generate one with:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRATION_MS=86400000

# Security and Seeding Configuration
APP_SEED_DEFAULT_USERS=true
APP_INITIAL_ADMIN_PASSWORD=change-me-admin-password
APP_INITIAL_ACCOUNTANT_PASSWORD=change-me-accountant-password
APP_INITIAL_VIEWER_PASSWORD=change-me-viewer-password
SWAGGER_PUBLIC=false

# Only needed if the browser calls the API directly on another host (the bundled Nginx proxy does not need it)
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# Frontend
FRONTEND_PORT=3000
